@page "/Company/Display/{id:int}"
@rendermode InteractiveAuto

<div class="row">
    <div class="col-md-6">
        <CompanyDisplayComponent id="@id"></CompanyDisplayComponent>
    </div>
    <div class="col-md-6">
        <PositionListGridComponent id="@id"></PositionListGridComponent>
        
    </div>
</div>

@code {
    [Parameter]
    public int id { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        int companyID = id;
        StateHasChanged();

    }
}
