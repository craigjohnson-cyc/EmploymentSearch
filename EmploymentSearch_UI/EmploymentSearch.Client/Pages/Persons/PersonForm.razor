                            <InputText id="name" class="form-control" @bind-Value="PersonModel.Name" />
                            <ValidationMessage For="() => PersonModel.Name" class="text-danger" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="company" class="form-label">Company *</label>
                            <InputSelect id="company" class="form-select" @bind-Value="PersonModel.CompanyKey">
                                <option value="0">-- Select Company --</option>
                                @foreach (var company in Companies)
                                {
                                    <option value="@company.CompanyKey">@company.CompanyName</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="() => PersonModel.CompanyKey" class="text-danger" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="position" class="form-label">Position *</label>
                            <InputSelect id="position" class="form-select" @bind-Value="PersonModel.PositionKey">
                                <option value="0">-- Select Position --</option>
                               @*  @foreach (var position in Positions)
                                {
                                    <option value="@position.PositionKey">@position.PositionTitle</option>
                                } *@
                            </InputSelect>
                            <ValidationMessage For="() => PersonModel.PositionKey" class="text-danger" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="email" class="form-label">Email</label>
                            <InputText id="email" class="form-control" type="email" @bind-Value="PersonModel.Email" />
                        </div>
                        <div class="col-md-6">
                            <label for="linkedin" class="form-label">LinkedIn</label>
                            <InputText id="linkedin" class="form-control" @bind-Value="PersonModel.LinkedIn" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="phoneOffice" class="form-label">Office Phone</label>
                            <InputText id="phoneOffice" class="form-control" @bind-Value="PersonModel.PhoneOffice" />
                        </div>
                        <div class="col-md-6">
                            <label for="phoneCell" class="form-label">Cell Phone</label>
                            <InputText id="phoneCell" class="form-control" @bind-Value="PersonModel.PhoneCell" />
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="preferedPhone" class="form-label">Preferred Phone</label>
                            <InputSelect id="preferedPhone" class="form-select" @bind-Value="PersonModel.PreferedPhone">
                                <option value="">-- Select --</option>
                                <option value="Cell">Cell</option>
                                <option value="Office">Office</option>
                                <option value="Either">Either</option>
                            </InputSelect>
                        </div>
                        <div class="col-md-6">
                            <label for="preferedContact" class="form-label">Preferred Contact</label>
                            <InputSelect id="preferedContact" class="form-select" @bind-Value="PersonModel.PreferedContact">
                                <option value="">-- Select --</option>
                                <option value="Email">Email</option>
                                <option value="Phone">Phone</option>
                                <option value="Either">Either</option>
                            </InputSelect>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="comment" class="form-label">Comments</label>
                            <InputTextArea id="comment" class="form-control" @bind-Value="PersonModel.Comment" rows="4" />
                        </div>
                    </div>

                   @* <div class="row mb-3">
