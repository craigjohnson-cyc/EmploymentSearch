@using EmploymentSearch_DataModel.Models.Entities
@using EmploymentSearch_DataModel.Models.DTOs
@using Microsoft.JSInterop
@page "/persons"
@* @inject IPersonService PersonService *@
@inject NavigationManager Navigation

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title">People</h1>
            <a href="/persons/create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Person
            </a>
        </div>

        @if (ShowAlert)
        {
            <div class="alert alert-@AlertType alert-dismissible fade show" role="alert">
                @AlertMessage
                <button type="button" class="btn-close" @onclick="() => ShowAlert = false"></button>
            </div>
        }

        <div class="card">
            <div class="card-body p-0">
                @if (Loading)
                {
                    <p class="text-center p-4">Loading...</p>
                }
                else if (Persons == null || !Persons.Any())
                {
                    <p class="text-center p-4 text-muted">No people found.</p>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Name</th>
                                <th>Company</th>
                                <th>Position</th>
                                <th>Email</th>
                                <th>Phone</th>
                                <th>Preferred Contact</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var person in Persons)
                            {
                                <tr>
                                    <td>
                                        <a href="/persons/@person.PersonKey" class="text-decoration-none">
                                            @person.Name
                                        </a>
                                    </td>
                                    <td>@person.Company?.CompanyName</td>
                                    <td>@person.Position?.PositionTitle</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(person.Email))
                                        {
                                            <a href="mailto:@person.Email">@person.Email</a>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(person.PhoneCell))
                                        {
                                            <span>@person.PhoneCell</span>
                                        }
                                        else if (!string.IsNullOrEmpty(person.PhoneOffice))
                                        {
                                            <span>@person.PhoneOffice</span>
                                        }
                                    </td>
                                    <td>@person.PreferedContact</td>
                                    <td>
                                        <a href="/persons/@person.PersonKey" class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePerson(person.PersonKey)">
                                            Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Person> Persons = new();
    private bool Loading = false;
    private bool ShowAlert = false;
    private string AlertMessage = "";
    private string AlertType = "info";

    protected override async Task OnInitializedAsync()
    {
        await LoadPersons();
    }

    private async Task LoadPersons()
    {
        Loading = true;
        try
        {
            Persons = await PersonService.GetAllPersons();
        }
        catch (Exception ex)
        {
            AlertType = "danger";
            AlertMessage = $"Error loading people: {ex.Message}";
            ShowAlert = true;
        }
        finally
        {
            Loading = false;
        }
    }

    private async Task DeletePerson(int id)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this person?");
        if (!confirmed)
            return;

        try
        {
            HttpResponseMessage success = await PersonService.DeletePerson(id);
            if (success.IsSuccessStatusCode)
            {
                AlertType = "success";
                AlertMessage = "Person deleted successfully!";
                ShowAlert = true;
                await LoadPersons();
            }
        }
        catch (Exception ex)
        {
            AlertType = "danger";
            AlertMessage = $"Error deleting person: {ex.Message}";
            ShowAlert = true;
        }
    }

    [Inject]
    protected IPersonService PersonService { get; set; } = null!;

    [Inject]
    protected IJSRuntime JS { get; set; } = null!;
}
