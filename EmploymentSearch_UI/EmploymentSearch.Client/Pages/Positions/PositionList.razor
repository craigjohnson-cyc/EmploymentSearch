@using EmploymentSearch_DataModel.Models.Entities
@using EmploymentSearch_DataModel.Models.DTOs
@page "/positions"
@* @inject IPositionService PositionService *@
@inject NavigationManager Navigation

<div class="row">
    <div class="col-md-12">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="page-title">Positions</h1>
            <a href="/positions/create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Position
            </a>
        </div>

        @if (ShowAlert)
        {
            <div class="alert alert-@AlertType alert-dismissible fade show" role="alert">
                @AlertMessage
                <button type="button" class="btn-close" @onclick="() => ShowAlert = false"></button>
            </div>
        }

        <div class="card">
            <div class="card-body p-0">
                @if (Loading)
                {
                    <p class="text-center p-4">Loading...</p>
                }
                else if (PositionsList == null || !PositionsList.Any())
                {
                    <p class="text-center p-4 text-muted">No positions found.</p>
                }
                else
                {
                    //<PositionsGrid Positions="PositionsList" OnRefresh="LoadPositions" />
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Position> PositionsList = new();
    private bool Loading = false;
    private bool ShowAlert = false;
    private string AlertMessage = "";
    private string AlertType = "info";

    // Need to figure out how to get the CompanyKey from the route or a service
    public int CompanyKey { get; set; } = 1; // Placeholder for demonstration

    protected override async Task OnInitializedAsync()
    {
        await LoadPositions();
    }

    private async Task LoadPositions()
    {
        Loading = true;
        try
        {
            //PositionsList = await PositionService.GetPosition(CompanyKey);
        }
        catch (Exception ex)
        {
            AlertType = "danger";
            AlertMessage = $"Error loading positions: {ex.Message}";
            ShowAlert = true;
        }
        finally
        {
            Loading = false;
        }
    }

    [Inject]
    protected IPositionService PositionService { get; set; } = null!;
}
