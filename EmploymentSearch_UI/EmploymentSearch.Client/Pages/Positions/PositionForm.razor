@inject IPositionService PositionService
@inject NavigationManager NavigationManager

<div class="row">
    <div class="col-md-8">
        <h1 class="page-title">@(IsNew ? "Create Position" : "Edit Position")</h1>

        @if (ShowAlert)
        {
            <div class="alert alert-@AlertType alert-dismissible fade show" role="alert">
                @AlertMessage
                <button type="button" class="btn-close" @onclick="@(() => ShowAlert = false)"></button>
            </div>
        }

    </div>
</div>

<div class="form-group">
    <div class="row mb-3">
        <div class="form-group">
            <label>Position Title</label>
            <InputText @bind-Value="position.PositionTitle" class="form-control" />
        </div>

        <div class="form-check">
            <InputCheckbox id="isRemote" class="form-check-input" @bind-Value="position.IsRemote" />
            <label class="form-check-label" for="isRemote">Remote Position</label>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="applicationDate" class="form-label">Application Date</label>
            <InputDate id="applicationDate" class="form-control" @bind-Value="position.ApplicationDate" />
        </div>
        <div class="col-md-6">
            <label for="rate" class="form-label">Pay Rate</label>
            <InputText id="rate" class="form-control" @bind-Value="position.Rate" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <label for="link" class="form-label">Job Posting Link</label>
            <InputText id="link" class="form-control" @bind-Value="position.Link" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-6">
            <label for="status" class="form-label">Status</label>
            <InputSelect id="status" class="form-select" @bind-Value="position.Status">
                <option value="">-- Select Status --</option>
                <option value="Applied">Applied</option>
                <option value="Reviewed">Reviewed</option>
                <option value="Interviewing">Interviewing</option>
                <option value="Offered">Offered</option>
                <option value="Rejected">Rejected</option>
                <option value="Accepted">Accepted</option>
            </InputSelect>
        </div>
        <div class="col-md-6">
            <label for="lastContactDate" class="form-label">Last Contact Date</label>
            <InputDate id="lastContactDate" class="form-control" @bind-Value="position.LastContactDate" />
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-12">
            <label for="note" class="form-label">Notes</label>
            <InputTextArea id="note" class="form-control" @bind-Value="position.Note" rows="4"></InputTextArea>
        </div>
    </div>

    <div class="row mb-3">
        <button type="button" class="btn btn-primary" @onclick="SavePosition" disabled="@IsSaving">
            @(IsSaving ? "Saving..." : "Save")
        </button>
        <button type="button" class="btn btn-secondary" @onclick="CancelForm">Cancel</button>
    </div>

</div>

@code {
    [Parameter]
    public int CompanyId { get; set; }

    [Parameter]
    public EventCallback OnPositionAdded { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    private JobPosition position = new();
    private bool IsSaving = false;
    private bool ShowAlert = false;
    private string AlertMessage = "";
    private string AlertType = "info";

    private bool IsNew => CompanyId > 0;  // need to think this through, how would Edit work?

    protected override void OnInitialized()
    {
        position.CompanyKey = CompanyId;
        // Set default ApplicationDate to today if creating new position
        if (IsNew)
        {
            position.ApplicationDate = DateTime.Now;
            position.Status = "Applied";
        }
    }

    private async Task SavePosition()
    {
        try
        {
            IsSaving = true;

            if (position.ApplicationDate == default)
            {
                position.ApplicationDate = DateTime.Now;
            }

            await PositionService.AddPosition(CompanyId, position);

            AlertMessage = "Position saved successfully!";
            AlertType = "success";
            ShowAlert = true;

            // Invoke the callback
            await OnPositionAdded.InvokeAsync();

            // Navigate back after a short delay
            await Task.Delay(1000);
            NavigationManager.NavigateTo("/positions");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving position: {ex.Message}");
            AlertMessage = $"Error saving position: {ex.Message}";
            AlertType = "danger";
            ShowAlert = true;
        }
        finally
        {
            IsSaving = false;
        }
    }

    private async Task CancelForm()
    {
        await OnCancel.InvokeAsync();
        NavigationManager.NavigateTo("/positions");
    }
}