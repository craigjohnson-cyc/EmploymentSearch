@code {
    [Parameter]
    public int? Id { get; set; }

    [SupplyParameterFromQuery]
    public int? PositionKey { get; set; }

    private Contact ContactModel = new();
    private List<Position> Positions = new();
    private List<Person> Persons = new();
    private bool IsNew => !Id.HasValue;
    private bool IsSaving = false;
    private bool ShowAlert = false;
    private string AlertMessage = "";
    private string AlertType = "info";

    protected override async Task OnInitializedAsync()
    {
        // await LoadPositions();
        // await LoadPersons();

        if (!IsNew)
        {
            var contact = await ContactService.GetContact(Id!.Value);
            if (contact != null)
            {
                ContactModel = contact;
            }
            else
            {
                AlertType = "danger";
                AlertMessage = "Contact not found.";
                ShowAlert = true;
            }
        }
        else if (PositionKey.HasValue)
        {
            ContactModel.PositionKey = PositionKey.Value;
            ContactModel.ContactDate = DateTime.Now;
        }
    }

