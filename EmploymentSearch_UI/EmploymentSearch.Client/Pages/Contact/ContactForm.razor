    //         Positions = await PositionService.GetAllContacts();
    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine($"Error loading positions: {ex.Message}");
    //     }
    // }

    // private async Task LoadPersons()
    // {
    //     try
    //     {
    //         Persons = await PersonService.GetAllPersonsAsync();
    //     }
    //     catch (Exception ex)
    //     {
    //         Console.WriteLine($"Error loading persons: {ex.Message}");
    //     }
    // }

    private async Task SaveContact()
    {
        IsSaving = true;
        try
        {
            if (ContactModel.ContactDate == default)
            {
                ContactModel.ContactDate = DateTime.Now;
            }

            if (IsNew)
            {
                var saved = await ContactService.AddContact(ContactModel);
                AlertType = "success";
                AlertMessage = "Contact created successfully!";
                ShowAlert = true;
                await Task.Delay(1500);
                Navigation.NavigateTo("/contacts");
            }
            else
            {
                await ContactService.UpdateContact(ContactModel);
                AlertType = "success";
                AlertMessage = "Contact updated successfully!";
                ShowAlert = true;
                await Task.Delay(1500);
                Navigation.NavigateTo("/contacts");
            }
        }
        catch (Exception ex)
        {
            AlertType = "danger";
            AlertMessage = $"Error saving contact: {ex.Message}";
            ShowAlert = true;
        }
        finally
        {
            IsSaving = false;
        }
    }

    [Inject]
    protected IContactService ContactService { get; set; } = null!;

    [Inject]
    protected IPositionService PositionService { get; set; } = null!;

    [Inject]
    protected IPersonService PersonService { get; set; } = null!;
}
