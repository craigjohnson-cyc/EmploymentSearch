@using System.Globalization
@using Microsoft.JSInterop

<div id="contactsGrid">
    @if (Contacts == null || !Contacts.Any())
    {
        <div class="alert alert-info mb-0">
            <i class="bi bi-info-circle"></i> No contacts recorded for this position yet.
            @if (PositionKey > 0)
            {
                <a href="/contacts/create?position_key=@PositionKey" class="alert-link">Add Contact</a>
            }
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Contact Date</th>
                        <th>Person</th>
                        <th>Method</th>
                        <th>Description</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var contact in Contacts)
                    {
                        <tr>
                            <td>
                                @if (contact.ContactDate != default)
                                {
                                    @contact.ContactDate.ToString("M-d-yyyy H:mm", CultureInfo.InvariantCulture)
                                }
                            </td>
                            <td>
                                @if (contact.Person != null)
                                {
                                    <a href="/persons/@contact.Person.PersonKey" class="text-decoration-none">
                                        @contact.Person.Name
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(contact.ContactMethod))
                                {
                                    <span class="badge bg-secondary">@contact.ContactMethod</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(contact.Description))
                                {
                                    <span title="@contact.Description" class="text-truncate d-inline-block" style="max-width: 200px;">
                                        @contact.Description
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" @onclick="() => OnEdit.InvokeAsync(contact)">
                                    Edit
                                </button>
@*                                 <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteContact(contact.ContactKey)">
                                    Delete
                                </button> *@
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<Contact> Contacts { get; set; } = new();

    [Parameter]
    public int PositionKey { get; set; } = 0;

    [Parameter]
    public EventCallback<Contact> OnEdit { get; set; }

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Inject]
    protected IContactService ContactService { get; set; } = null!;

    [Inject]
    protected IJSRuntime JS { get; set; } = null!;

