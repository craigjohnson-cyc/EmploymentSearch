@using System.Globalization
@using EmploymentSearch_DataModel.Models.Entities
@using EmploymentSearch_DataModel.Models.DTOs
@using Microsoft.JSInterop

<div id="positionsGrid">
    @if (Positions == null || !Positions.Any())
    {
        <p class="text-center p-4 text-muted">No positions found.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-striped table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Job Title</th>
                        <th>Remote</th>
                        <th>Note</th>
                        <th>Pay Rate</th>
                        <th>Application Date</th>
                        <th>Last Contact Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var pos in Positions)
                    {
                        <tr data-position-key="@pos.PositionKey" class="position-row">
                            <td>
                                <a href="/positions/@pos.PositionKey" class="text-decoration-none">
                                    @pos.PositionTitle
                                </a>
                            </td>
                            <td>
                                @if (pos.IsRemote)
                                {
                                    <span class="badge bg-success">Yes</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">No</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(pos.Note))
                                {
                                    <span class="note-clamp" title="@pos.Note">@pos.Note</span>
                                }
                            </td>
                            <td>@pos.Rate</td>
                            <td>
                                @if (pos.ApplicationDate.HasValue)
                                {
                                    @pos.ApplicationDate.Value.ToString("M-d-yyyy", CultureInfo.InvariantCulture)
                                }
                            </td>
                            <td>
                                @if (pos.LastContactDate.HasValue)
                                {
                                    @pos.LastContactDate.Value.ToString("M-d-yyyy", CultureInfo.InvariantCulture)
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(pos.Status))
                                {
                                    <span class="badge @GetStatusBadgeClass(pos.Status)">@pos.Status</span>
                                }
                            </td>
                            <td>
                                <a href="@GetPositionEditUrl(pos.PositionKey)" class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                                @if (CompanyKey > 0)
                                {
                                    <button class="btn btn-sm btn-outline-warning" @onclick="() => UpdatePositionStatus(pos.PositionKey, StatusRejected)">
                                        Rejected
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => UpdatePositionStatus(pos.PositionKey, StatusClosed)">
                                        Closed
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePosition(pos.PositionKey)">
                                        Delete
                                    </button>
                                }
                            </td>
                        </tr>
                        <tr class="contacts-row" style="display:none;">
                            <td colspan="8">
                                <div id="contacts-@pos.PositionKey"></div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter]
    public List<JobPosition> Positions { get; set; } = new();

    [Parameter]
    public int CompanyKey { get; set; } = 0;

    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Inject]
    protected IPositionService PositionService { get; set; } = null!;

    [Inject]
    protected IJSRuntime JS { get; set; } = null!;

    private const string StatusRejected = "Rejected";
    private const string StatusClosed = "Closed";

    private string GetQueryParams() => CompanyKey > 0 ? $"?company_key={CompanyKey}" : string.Empty;

    private string GetPositionEditUrl(int positionKey) => $"/positions/{positionKey}{GetQueryParams()}";

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "applied" => "bg-info",
            "reviewed" => "bg-primary",
            "interviewing" => "bg-warning text-dark",
            "offered" => "bg-success",
            "rejected" => "bg-danger",
            "accepted" => "bg-success",
            "closed" => "bg-secondary",
            _ => "bg-secondary"
        };
    }

    private async Task UpdatePositionStatus(int positionId, string status)
    {
        try
        {
            HttpResponseMessage success = await PositionService.UpdatePositionStatus(positionId, status);
            if (success.IsSuccessStatusCode)
            {
                if (OnRefresh.HasDelegate)
                {
                    await OnRefresh.InvokeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating position status: {ex.Message}");
        }
    }

    private async Task DeletePosition(int positionId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", "Are you sure you want to delete this position?");
        if (!confirmed)
            return;

        try
        {
            HttpResponseMessage success = await PositionService.DeletePosition(positionId);
            if (success.IsSuccessStatusCode)
            {
                if (OnRefresh.HasDelegate)
                {
                    await OnRefresh.InvokeAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting position: {ex.Message}");
        }
    }
}
