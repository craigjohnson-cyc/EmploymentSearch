@inject ICompanyService CompanyService

@if (companies == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <style>
        .no-show {
            display: none !important;
        }
    </style>
    <style>
        .e-pagerdropdown {
            height: 43px !important;
        }

        span.e-ddl.e-lib.e-input-group.e-control-container.e-control-wrapper.e-valid-input {
            height: 39px;
        }

        input#dropdownlist-82b398d8-e35c-4346-acc7-6ee8eba3a344 {
            height: 37px;
        }
    </style>
    <style>
        .e-pager .e-spacing, .e-pager .e-numericitem:hover, .e-pager .e-currentitem {
            padding: 9.5px 11px 8.5px 12px;
        }

        .e-pager .e-pagercontainer .e-nextpage {
            padding: 12px 10px 10px 9px;
        }

        .e-pager .e-pagercontainer .e-prevpage {
            padding: 12px 10px 10px 9px;
        }

        .e-pager .e-pagercontainer .e-firstpage {
            padding: 12px 10px 10px;
        }

        .e-pager .e-np {
            padding: 12.5px 11px 8.5px 10px !important;
        }

        .e-pager .e-pagercontainer .e-lastpage {
            padding: 12px 10px 10px 8px;
        }
    </style>

    <table class="table">
        <thead>
            <tr>
                <th class="no-show">Company Key</th>
                <th>Company Name</th>
                <th class="no-show">Phone</th>
                <th>Website</th>
                <th class="no-show">Address</th>
                <th class="no-show">Address 2</th>
                <th class="no-show">City</th>
                <th class="no-show">State</th>
                <th class="no-show">Zip</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var company in companies)
            {
                <CompanyListTableItemComponent Company="company" />    
            }
        </tbody>
    </table>

    <Pagination ActivePageNumber=@currentPageNumber
                TotalPages="15"
                DisplayPages="5"
                PageChanged="OnPageChangedAsync" />

}

@code {

    List<Company> companies;
    int currentPageNumber = 1;

    protected override async Task OnInitializedAsync()
    {
        int pageNumber = 1;
        int pageSize = 10;
        companies = await CompanyService.GetCompanies(pageNumber, pageSize);
        await base.OnInitializedAsync();
    }

    private async Task OnPageChangedAsync(int newPageNumber)
    {
        int pageSize = 10;
        companies.Clear();
        currentPageNumber = newPageNumber;
        companies = await CompanyService.GetCompanies(newPageNumber, pageSize);
//        <Pagination ActivePageNumber="@newPageNumber"/>
    }
}
